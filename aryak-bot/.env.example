# Claude (key from console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Zinax Stock: web app URL (ends in /exec) and "Token for the AI assistant" from the Apps Script log
SHEET_URL=
ZINAX_BOT_TOKEN=

# WhatsApp numbers, digits with country code
PAIR_PHONE=9715XXXXXXXX
SALES_MANAGER_JID=9715XXXXXXXX@s.whatsapp.net
STAFF_NUMBERS=9715XXXXXXX1,9715XXXXXXX2,9715XXXXXXX3,9715XXXXXXX4,9715XXXXXXX5
TEAM_TAGS={"sales":["9715XXXXXXX1"],"accounts":["9715XXXXXXX2"],"logistics":["9715XXXXXXX3"],"complaints":["9715XXXXXXX1"],"team":["9715XXXXXXX1"]}

# Groups it works in: a word in the group name (comma separated), or group JIDs
ALLOWED_GROUP_NAMES=ARYAK
ALLOWED_GROUPS=

# Invoice check, report only. Words in group names: customers' PO PDFs arrive in the first, colleagues' invoices in the
# second, mismatches are reported in the third (the bot must be a member of all three)
WATCH_GROUP_NAMES=
INVOICE_GROUP_NAME=
INFO_GROUP_NAME=

# The team: admins may give commands (status, last, pause, resume, staff); colleagues are answered in these groups when
# they mention the bot, reply to it or say its name, and in private chats. Never list a customer group here.
ADMIN_NUMBERS=
STAFF_GROUP_NAMES=
COMMAND_GROUP_NAMES=
BOT_NAMES=
# Her name: how she introduces herself and signs (default آتوسا)
BOT_DISPLAY_NAME=

# Voice notes (Google Speech-to-Text through the VM's service account): VOICE=off turns them off
VOICE=on
SPEECH_LANGUAGES=fa-IR,ar-AE,en-IN,ur-PK
SPEECH_MIN_CONFIDENCE=0.5

# Change this value to send one greeting to the bot's own number (PAIR_PHONE) on the next start
HELLO_ONCE=

# Optional
WAIT_MINUTES=5
MANAGER_DEDUPE_MINUTES=60

# Groups of countable goods (accessories, saw blades, glue): one word of each name, comma separated
GOODS_GROUP_NAMES=accessories,saw blade

# Live-test group(s): one word of the name. The account's own messages run the real paths there, reports stay in the group, separate order memory
TEST_GROUP_NAMES=

# Good-morning message: ONLY groups listed here get it (one word of each name, comma separated). Empty = nothing is sent.
MORNING_GROUP_NAMES=
# MORNING_TIME=08:30  MORNING_CATCHUP_UNTIL=10:00  MORNING_OFF_DAYS=friday  MORNING_WEEKEND_DAYS=thursday  MORNING_DAILY_CAP=40  MORNING_GAP_MIN_SECONDS=20  MORNING_GAP_MAX_SECONDS=60

# Cut photos against the warehouse sheet: recheck hour next morning, how few differences go to the summary instead of a message, tolerance per operation (metres)
# SHEET_RECHECK_HOUR=9  SHEET_DIGEST_MAX=2  CUT_TOLERANCE_METRES=0.5  INFO_GAP_SECONDS=6  REMINDERS=off
